CREATE TABLE tee_sets (\
  id UUID PRIMARY KEY DEFAULT uuid_generate_v4(),\
  course_id UUID REFERENCES courses(id),\
  name TEXT NOT NULL,\
  color TEXT,\
  gender TEXT CHECK (gender IN ('men', 'women', 'unisex')),\
  par INTEGER,\
  course_rating DECIMAL(4, 1),\
  slope_rating INTEGER,\
  total_yardage INTEGER,\
  front_nine_yardage INTEGER,\
  back_nine_yardage INTEGER,\
  created_at TIMESTAMPTZ DEFAULT NOW(),\
  updated_at TIMESTAMPTZ DEFAULT NOW()\
);\
\
CREATE TABLE holes (\
  id UUID PRIMARY KEY DEFAULT uuid_generate_v4(),\
  course_id UUID REFERENCES courses(id),\
  hole_number INTEGER NOT NULL CHECK (hole_number BETWEEN 1 AND 18),\
  par INTEGER CHECK (par BETWEEN 3 AND 6),\
  handicap INTEGER CHECK (handicap BETWEEN 1 AND 18),\
  geo_lat DECIMAL(10, 7),\
  geo_lng DECIMAL(10, 7),\
  created_at TIMESTAMPTZ DEFAULT NOW(),\
  updated_at TIMESTAMPTZ DEFAULT NOW(),\
  UNIQUE (course_id, hole_number)\
);\
\
CREATE TABLE hole_tee_data (\
  id UUID PRIMARY KEY DEFAULT uuid_generate_v4(),\
  hole_id UUID REFERENCES holes(id),\
  tee_set_id UUID REFERENCES tee_sets(id),\
  yardage INTEGER,\
  par INTEGER CHECK (par BETWEEN 3 AND 6),\
  handicap INTEGER CHECK (handicap BETWEEN 1 AND 18),\
  created_at TIMESTAMPTZ DEFAULT NOW(),\
  updated_at TIMESTAMPTZ DEFAULT NOW(),\
  UNIQUE (hole_id, tee_set_id)\
);\
\
CREATE TABLE user_courses (\
  id UUID PRIMARY KEY DEFAULT uuid_generate_v4(),\
  user_id UUID REFERENCES auth.users(id),\
  course_id UUID REFERENCES courses(id),\
  is_favorite BOOLEAN DEFAULT FALSE,\
  last_played_date DATE,\
  created_at TIMESTAMPTZ DEFAULT NOW(),\
  updated_at TIMESTAMPTZ DEFAULT NOW(),\
  UNIQUE (user_id, course_id)\
);\
\
CREATE TABLE users (\
