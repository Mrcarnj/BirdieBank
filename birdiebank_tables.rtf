CREATE TABLE friends (
  id UUID PRIMARY KEY DEFAULT uuid_generate_v4(),
  user_id UUID REFERENCES users(id) NOT NULL,
  friend_user_id UUID REFERENCES users(id),
  name TEXT NOT NULL,
  handicap_index DECIMAL(4, 1),
  profile_image_url TEXT,
  email TEXT,
  is_guest BOOLEAN DEFAULT FALSE,
  is_favorite BOOLEAN DEFAULT FALSE,
  last_played_date TIMESTAMPTZ,
  created_at TIMESTAMPTZ DEFAULT NOW(),
  updated_at TIMESTAMPTZ DEFAULT NOW(),
  -- Prevent duplicate friend relationships
  UNIQUE (user_id, friend_user_id)
);

CREATE TABLE rounds (
  id UUID PRIMARY KEY DEFAULT uuid_generate_v4(),
  user_id UUID REFERENCES users(id) NOT NULL,
  course_id UUID REFERENCES courses(id) NOT NULL,
  date TIMESTAMPTZ NOT NULL,
  hole_selection TEXT CHECK (hole_selection IN ('front9', 'back9', 'full18', 'custom')),
  custom_start_hole INTEGER CHECK (custom_start_hole BETWEEN 1 AND 18),
  custom_end_hole INTEGER CHECK (custom_end_hole BETWEEN 1 AND 18),
  is_completed BOOLEAN DEFAULT FALSE,
  weather_temperature DECIMAL(5, 2),
  weather_conditions TEXT,
  weather_wind_speed DECIMAL(5, 2),
  notes TEXT,
  created_at TIMESTAMPTZ DEFAULT NOW(),
  updated_at TIMESTAMPTZ DEFAULT NOW()
);

CREATE TABLE round_players (
  id UUID PRIMARY KEY DEFAULT uuid_generate_v4(),
  round_id UUID REFERENCES rounds(id) NOT NULL,
  friend_id UUID REFERENCES friends(id) NOT NULL,
  tee_set_id UUID REFERENCES tee_sets(id),
  handicap_at_time DECIMAL(4, 1),
  total_score INTEGER,
  created_at TIMESTAMPTZ DEFAULT NOW(),
  updated_at TIMESTAMPTZ DEFAULT NOW(),
  UNIQUE (round_id, friend_id)
);

CREATE TABLE scores (
  id UUID PRIMARY KEY DEFAULT uuid_generate_v4(),
  round_player_id UUID REFERENCES round_players(id) NOT NULL,
  hole_number INTEGER NOT NULL CHECK (hole_number BETWEEN 1 AND 18),
  par INTEGER CHECK (par BETWEEN 3 AND 6),
  strokes INTEGER NOT NULL,
  putts INTEGER,
  fairway_hit BOOLEAN,
  green_in_regulation BOOLEAN,
  penalties INTEGER,
  created_at TIMESTAMPTZ DEFAULT NOW(),
  updated_at TIMESTAMPTZ DEFAULT NOW(),
  UNIQUE (round_player_id, hole_number)
);

CREATE TABLE games (
  id UUID PRIMARY KEY DEFAULT uuid_generate_v4(),
  name TEXT NOT NULL,
  description TEXT,
  created_at TIMESTAMPTZ DEFAULT NOW(),
  updated_at TIMESTAMPTZ DEFAULT NOW()
);

CREATE TABLE round_games (
  id UUID PRIMARY KEY DEFAULT uuid_generate_v4(),
  round_id UUID REFERENCES rounds(id) NOT NULL,
  game_id UUID REFERENCES games(id) NOT NULL,
  settings JSONB NOT NULL,
  created_at TIMESTAMPTZ DEFAULT NOW(),
  updated_at TIMESTAMPTZ DEFAULT NOW()
);

CREATE TABLE course_coordinate_points (
  id UUID PRIMARY KEY DEFAULT uuid_generate_v4(),
  course_id UUID REFERENCES courses(id),
  hole_number INTEGER CHECK (hole_number BETWEEN 1 AND 18),
  poi INTEGER,
  location INTEGER,
  side_fairway INTEGER,
  geo_lat DECIMAL(10, 7),
  geo_lng DECIMAL(10, 7),
  created_at TIMESTAMPTZ DEFAULT NOW(),
  updated_at TIMESTAMPTZ DEFAULT NOW()
);

